if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(0.5)

local player = game.Players.LocalPlayer
local pGui = player:WaitForChild("PlayerGui")
local SoundService = game:GetService("SoundService")

if pGui:FindFirstChild("RoundedChatSys") then
    pGui.RoundedChatSys:Destroy()
end

local ScreenGui = Instance.new("ScreenGui")
local Container = Instance.new("Frame")
local UIListLayout = Instance.new("UIListLayout")

ScreenGui.Name = "RoundedChatSys"
ScreenGui.Parent = pGui
ScreenGui.ResetOnSpawn = true 

Container.Name = "MessageContainer"
Container.Parent = ScreenGui
Container.Size = UDim2.new(0.6, 0, 0.4, 0)
Container.Position = UDim2.new(0.5, 0, 0.80, 0) 
Container.AnchorPoint = Vector2.new(0.5, 1) 
Container.BackgroundTransparency = 1

UIListLayout.Parent = Container
UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIListLayout.Padding = UDim.new(0, 8)

local TauntSound = Instance.new("Sound")
TauntSound.Name = "PatchouliVoice"
TauntSound.SoundId = "assetid://118575496502909"
TauntSound.Volume = 10
TauntSound.Parent = SoundService

player.CharacterAdded:Connect(function(char)
    local humanoid = char:WaitForChild("Humanoid")
    humanoid.Died:Connect(function()
        TauntSound:Stop()
    end)
end)

local function createMessage(msg)
    local TextService = game:GetService("TextService")
    local Bubble = Instance.new("Frame")
    local UICorner = Instance.new("UICorner")
    local TextLabel = Instance.new("TextLabel")
    
    Bubble.Name = "ChatBubble"
    Bubble.Parent = Container
    Bubble.BackgroundColor3 = Color3.fromRGB(30, 30, 30)
    Bubble.BackgroundTransparency = 1 
    Bubble.BorderSizePixel = 0
    UICorner.CornerRadius = UDim.new(0, 12)
    UICorner.Parent = Bubble
    
    TextLabel.Parent = Bubble
    TextLabel.BackgroundTransparency = 1
    TextLabel.Size = UDim2.new(1, -20, 1, 0)
    TextLabel.Position = UDim2.new(0, 10, 0, 0)
    TextLabel.Font = Enum.Font.Arcade
    TextLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextLabel.TextSize = 18
    TextLabel.TextTransparency = 1
    TextLabel.Text = msg

    local textSize = TextService:GetTextSize(msg, TextLabel.TextSize, TextLabel.Font, Vector2.new(800, 400))
    Bubble.Size = UDim2.new(0, math.clamp(textSize.X + 30, 50, 400), 0, 35)

    local TweenService = game:GetService("TweenService")
    local info = TweenInfo.new(0.3, Enum.EasingStyle.Sine)
    
    TweenService:Create(Bubble, info, {BackgroundTransparency = 0.15}):Play()
    TweenService:Create(TextLabel, info, {TextTransparency = 0}):Play()

    task.delay(3, function()
        if Bubble and Bubble.Parent then
            local fadeOut = TweenService:Create(Bubble, info, {BackgroundTransparency = 1})
            TweenService:Create(TextLabel, info, {TextTransparency = 1}):Play()
            fadeOut:Play()
            fadeOut.Completed:Connect(function()
                Bubble:Destroy()
            end)
        end
    end)
end

game:GetService("UserInputService").InputBegan:Connect(function(input, gpe)
    if not gpe and input.KeyCode == Enum.KeyCode.T then
        if player.Character and player.Character:FindFirstChild("Humanoid") and player.Character.Humanoid.Health > 0 then
            task.spawn(function()
                TauntSound:Play()
                createMessage("IM JUST..")
                task.wait(0.1) 
                createMessage("A BIT. TIRED")
            end)
        end
    end
end)

player.Chatted:Connect(function(msg)
    task.spawn(function()
        createMessage(msg)
    end)
end)

print("Arcade Chat Loaded")
