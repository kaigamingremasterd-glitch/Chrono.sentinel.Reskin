if not game:IsLoaded() then game.Loaded:Wait() end
task.wait(0.5)

local player = game.Players.LocalPlayer
local pGui = player:WaitForChild("PlayerGui")
local TextService = game:GetService("TextService")
local TweenService = game:GetService("TweenService")
local RunService = game:GetService("RunService")
local Debris = game:GetService("Debris")

-- SFX REPOSITORY
local SoundHost = Instance.new("Folder", pGui)
SoundHost.Name = "SFX_Stable_Host"

local function setupSound(id, name, vol)
    local s = Instance.new("Sound")
    s.Name = name
    s.SoundId = "rbxassetid://" .. id:gsub("%D", "")
    s.Volume = vol
    s.Parent = SoundHost
    return s
end

local talkBase = setupSound("131315204380991", "Talk", 5)
local emojiBase = setupSound("118573402202689", "Emoji", 3)
local yaaiBase = setupSound("87635098664780", "YAAI", 5)
local tiredBase = setupSound("118575496502909", "TiredVoice", 5) -- YOUR NEW ASSET

-- STABLE PLAY LOGIC
local function playGlobal(baseSound, p, v, life)
    local s = baseSound:Clone()
    s.PlaybackSpeed = p
    s.Volume = v
    s.Parent = SoundHost
    s:Play()
    Debris:AddItem(s, life or 3)
end

if pGui:FindFirstChild("RoundedChatSys") then
    pGui.RoundedChatSys:Destroy()
end

local ScreenGui = Instance.new("ScreenGui", pGui)
ScreenGui.Name = "RoundedChatSys"
ScreenGui.ResetOnSpawn = false

local Container = Instance.new("Frame", ScreenGui)
Container.Name = "MessageContainer"
Container.Size = UDim2.new(0.4, 0, 0.4, 0)
Container.Position = UDim2.new(0.5, 0, 0.85, 0) 
Container.AnchorPoint = Vector2.new(0.5, 1) 
Container.BackgroundTransparency = 1

local UIListLayout = Instance.new("UIListLayout", Container)
UIListLayout.VerticalAlignment = Enum.VerticalAlignment.Bottom
UIListLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
UIListLayout.Padding = UDim.new(0, 8)

local function isEmoji(char)
    return char:match("[%z\1-\127]") == nil 
end

local function createMessage(msg)
    local lowMsg = msg:lower()
    local isYaai = lowMsg:find("yaai") or msg:find("☺") or msg:find("☻")
    local isTired = lowMsg:find("tired") -- Trigger for the new voice line
    
    local AnchorFrame = Instance.new("Frame", Container) 
    local Bubble = Instance.new("Frame", AnchorFrame)
    local TextLabel = Instance.new("TextLabel", Bubble)
    local UICorner = Instance.new("UICorner", Bubble)
    
    local displayMsg = isYaai and "☺ ☺ ☺" or msg
    local textSize = TextService:GetTextSize(displayMsg, 18, Enum.Font.Arcade, Vector2.new(400, 1000))
    local finalSize = UDim2.new(0, math.clamp(textSize.X + 30, 60, 430), 0, textSize.Y + 15)

    AnchorFrame.BackgroundTransparency = 1
    AnchorFrame.Size = finalSize
    Bubble.BackgroundColor3 = Color3.fromRGB(25, 20, 25)
    Bubble.BackgroundTransparency = 0.2
    Bubble.Size = UDim2.new(1, 0, 1, 0)
    UICorner.CornerRadius = UDim.new(0, 10)
    
    TextLabel.BackgroundTransparency = 1
    TextLabel.Size = UDim2.new(1, -20, 1, -10)
    TextLabel.Position = UDim2.new(0, 10, 0, 5)
    TextLabel.Font = Enum.Font.Arcade
    TextLabel.TextColor3 = Color3.fromRGB(100, 20, 100)
    TextLabel.TextSize = 18
    TextLabel.Text = "" 
    TextLabel.TextWrapped = true

    -- Constant Jitter
    local shakeConnection
    shakeConnection = RunService.RenderStepped:Connect(function()
        if not Bubble or not Bubble.Parent then shakeConnection:Disconnect() return end
        Bubble.Position = UDim2.new(0, math.random(-1.5, 1.5), 0, math.random(-1.5, 1.5))
    end)

    task.spawn(function()
        if isYaai then
            playGlobal(yaaiBase, 1, 5, 6)
            task.spawn(function()
                while Bubble and Bubble.Parent do
                    TextLabel.Text = "☺ ☺ ☺"; task.wait(0.5)
                    if not Bubble.Parent then break end
                    TextLabel.Text = "☻ ☻ ☻"; task.wait(0.5)
                end
            end)
        elseif isTired then
            -- Play the Patchouli Tired Voice Line
            playGlobal(tiredBase, 1, 5, 5)
            -- Typewriter still works for the text
            for _, code in utf8.codes(msg) do
                TextLabel.Text = TextLabel.Text .. utf8.char(code)
                task.wait(0.04)
            end
        else
            -- Normal typewriter with blips
            for _, code in utf8.codes(msg) do
                local char = utf8.char(code)
                TextLabel.Text = TextLabel.Text .. char
                
                local p = math.random(30, 70) / 10 
                local d = 0.04
                local v = 5
                local it = 1

                local n = tonumber(char)
                if n then p = (n == 0) and 0.1 or (n * 0.2)
                elseif char == "." then p = 0.1; d = 1.0; v = 15
                elseif char == "#" then p = 0.1; v = 20
                elseif char == "!" then p = 8
                elseif char == "?" then p = 3; d = 0.6
                elseif char == "," then p = 1; d = 0.5
                elseif char == '"' then p = 5
                elseif char == "'" then p = 3
                elseif char == "/" or char == "\\" then it = 2
                elseif char == "*" then it = 3; p = 4
                end

                if char ~= " " then
                    for _ = 1, it do
                        playGlobal(isEmoji(char) and emojiBase or talkBase, math.clamp(p, 0.1, 15), isEmoji(char) and 3 or v, 1)
                        if it > 1 then task.wait(0.02) end
                    end
                end
                task.wait(d)
            end
        end
    end)

    -- Color Pulse
    task.spawn(function()
        local c1, c2 = Color3.fromRGB(100, 20, 100), Color3.fromRGB(255, 50, 255)
        while Bubble and Bubble.Parent do
            TweenService:Create(TextLabel, TweenInfo.new(1), {TextColor3 = c2}):Play()
            task.wait(1)
            if not Bubble.Parent then break end
            TweenService:Create(TextLabel, TweenInfo.new(1), {TextColor3 = c1}):Play()
            task.wait(1)
        end
    end)

    Debris:AddItem(AnchorFrame, isYaai and 6 or 10)
end

